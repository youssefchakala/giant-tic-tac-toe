{
  "name": "Giant Tic-Tac-Toe",
  "short_name": "Tic-Tac-Toe+",
  "description": "Tic-tac-toe inside tic-tac-toe. Play on one phone, against the phone, or online with a friend.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F7FB",
